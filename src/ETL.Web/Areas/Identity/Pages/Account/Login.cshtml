@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <div class="brand-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <!-- Left Database (Extract) -->
                    <ellipse cx="5" cy="7" rx="3" ry="2"/>
                    <path d="M2 7v10A3 2 0 0 0 8 17V7"/>
                    <path d="M2 12A3 2 0 0 0 8 12"/>
                    <!-- Right Database (Load) -->
                    <ellipse cx="19" cy="7" rx="3" ry="2"/>
                    <path d="M16 7v10A3 2 0 0 0 22 17V7"/>
                    <path d="M16 12A3 2 0 0 0 22 12"/>
                    <!-- Middle Gear (Transform) -->
                    <circle cx="12" cy="12" r="2"/>
                    <path d="M12 10V9"/>
                    <path d="M12 14v1"/>
                    <path d="M13.4 10.6l.7-.7"/>
                    <path d="M10.6 13.4l-.7.7"/>
                    <path d="M13.4 13.4l.7.7"/>
                    <path d="M10.6 10.6l-.7-.7"/>
                    <!-- Flow Arrows -->
                    <path d="M8 12h2"/>
                    <path d="M9 11l1 1-1 1"/>
                    <path d="M14 12h2"/>
                    <path d="M15 11l1 1-1 1"/>
                </svg>
            </div>
            <h1 class="auth-title">Welcome Back</h1>
            <p class="auth-subtitle">Sign in to continue to ETL Studio</p>
        </div>

        <form id="account" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger app-alert" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                <label asp-for="Input.Email">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" placeholder="password" autocomplete="current-password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-auth">Sign In</button>
        </form>

        @if (Model.ExternalLogins?.Count > 0)
        {
            <div class="auth-divider">
                <span>or</span>
            </div>

            <form id="external-account" method="post" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    @if (provider.Name == "Google")
                    {
                        <button type="submit" class="btn btn-google" name="provider" value="@provider.Name"
                                title="Sign in with your @provider.DisplayName account">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                                <path fill="none" d="M0 0h48v48H0z"/>
                            </svg>
                            Continue with Google
                        </button>
                    }
                }
            </form>
        }

        <div class="auth-footer">
            <p>Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a></p>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: var(--app-card);
        border: 1px solid rgba(20, 122, 108, 0.12);
        border-radius: 20px;
        box-shadow: var(--app-shadow);
        padding: 2.5rem 2rem;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .brand-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        background: linear-gradient(135deg, var(--app-brand), var(--app-brand-2));
        border-radius: 16px;
        color: white;
        margin-bottom: 1.25rem;
        box-shadow: 0 8px 20px rgba(20, 122, 108, 0.25);
    }

    .auth-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--app-ink);
        margin-bottom: 0.5rem;
    }

    .auth-subtitle {
        color: var(--app-muted);
        font-size: 0.95rem;
        margin: 0;
    }

    .auth-form {
        margin-bottom: 1.5rem;
    }

    .form-floating > label {
        color: var(--app-muted);
    }

    .btn-auth {
        width: 100%;
        padding: 0.875rem;
        font-size: 1rem;
    }

    .auth-footer {
        text-align: center;
        padding-top: 1rem;
        border-top: 1px solid var(--app-line);
    }

    .auth-footer p {
        margin: 0;
        color: var(--app-muted);
    }

    .auth-footer a {
        color: var(--app-brand);
        font-weight: 600;
        text-decoration: none;
    }

    .auth-footer a:hover {
        color: var(--app-brand-2);
    }

    [data-bs-theme="dark"] .auth-card {
        background: var(--app-card);
    }

    [data-bs-theme="dark"] .auth-title {
        color: var(--app-ink);
    }

    [data-bs-theme="dark"] .brand-icon {
        color: #022c22;
    }

    [data-bs-theme="dark"] .auth-footer a {
        color: var(--app-brand);
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.25rem 0;
        color: var(--app-muted);
        font-size: 0.85rem;
    }

    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--app-line);
    }

    .btn-google {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.625rem;
        width: 100%;
        padding: 0.75rem;
        background: var(--app-card);
        border: 1px solid var(--app-line);
        border-radius: 10px;
        color: var(--app-ink);
        font-size: 0.95rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
        text-decoration: none;
    }

    .btn-google:hover {
        background: rgba(20, 122, 108, 0.05);
        border-color: var(--app-brand);
        box-shadow: 0 2px 8px rgba(20, 122, 108, 0.12);
        color: var(--app-ink);
    }

    [data-bs-theme="dark"] .btn-google {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.12);
    }

    [data-bs-theme="dark"] .btn-google:hover {
        background: rgba(20, 122, 108, 0.12);
        border-color: var(--app-brand);
    }
</style>